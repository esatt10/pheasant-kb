# Isolated parser. Build with the repository root as context.
FROM python:3.12-slim
COPY pyproject.toml /opt/gtm/pyproject.toml
RUN python -c "import ctypes, re, subprocess, sys, tomllib; ctypes.CDLL('libseccomp.so.2'); deps=tomllib.load(open('/opt/gtm/pyproject.toml','rb'))['project']['dependencies']; subprocess.check_call([sys.executable,'-m','pip','install','--no-cache-dir',*[x for x in deps if re.split(r'[<>=]',x)[0] in {'beautifulsoup4','pydantic'}]])"
COPY src/pheasant/__init__.py src/pheasant/version.py /usr/local/lib/python3.12/site-packages/pheasant/
COPY extensions/gtm/src/pheasant_gtm /usr/local/lib/python3.12/site-packages/pheasant_gtm
COPY src/pheasant/security/__init__.py src/pheasant/security/url_policy.py /usr/local/lib/python3.12/site-packages/pheasant/security/
WORKDIR /opt/gtm
RUN install -d -m 0700 -o 10001 -g 10001 /run/pheasant-gtm
USER 10001:10001
ENTRYPOINT ["python", "-I", "-B", "-m", "pheasant_gtm.worker"]
