{
  "inputs": [
    {
      "type": "promptString",
      "id": "pheasant-token",
      "description": "pheasant API token (docker compose exec api sh -c 'cat /run/pheasant/secrets/api-token')",
      "password": true
    }
  ],
  "servers": {
    "pheasant": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp",
      "headers": {
        "Authorization": "Bearer ${input:pheasant-token}"
      }
    }
  }
}
