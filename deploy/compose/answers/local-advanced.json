{
  "pheasant.name": "pheasant-local-advanced",
  "pheasant.description": "Feature-rich single-node Pheasant profile with SQLite, LanceDB, OpenAI, WASM, MCP, and durable memory",
  "pheasant.environment": "docker",
  "pheasant.log_level": "INFO",
  "pheasant.state_path": "/state",
  "pheasant.workspace_root": "/workspace",
  "pheasant.exports_path": "/exports",
  "server.host": "0.0.0.0",
  "server.port": 8765,
  "server.role": "all",
  "server.mcp.enabled": true,
  "server.mcp.transports": {
    "stdio": false,
    "streamable_http": true,
    "sse": false
  },
  "server.api.enabled": true,
  "server.api.openapi": true,
  "server.api.max_concurrent_requests": 128,
  "server.api.drain_seconds": 10,
  "server.api.graph_refresh_seconds": 15,
  "server.ui.enabled": true,
  "server.ui.graph_visualization": true,
  "storage.backend": "sqlite",
  "storage.graph_snapshots": true,
  "storage.graph_snapshot_interval_seconds": 600,
  "storage.graph_checkpoint_seconds": 60,
  "storage.checkpoint_mtbf_seconds": 86400,
  "storage.graph_checkpoint_max_seconds": 900,
  "storage.compression": "zstd",
  "storage.max_state_size_gb": 50,
  "search.default_mode": "hybrid",
  "search.max_results_default": 50,
  "search.embeddings.enabled": true,
  "search.embeddings.provider": "openai-spec",
  "search.embeddings.model": "text-embedding-3-small",
  "search.embeddings.base_url": "https://api.openai.com/v1",
  "search.embeddings.api_key_env": "OPENAI_API_KEY",
  "search.embeddings.dimensions": 1536,
  "search.embeddings.batch_size": 128,
  "search.embeddings.max_retries": 8,
  "search.embeddings.retry_backoff_seconds": 1.0,
  "search.vector_store.provider": "lancedb",
  "search.vector_store.path": "/state/vectors",
  "search.wasm_relationship_search": true,
  "ingestion.captioner.provider": "openai-spec",
  "ingestion.captioner.model": "gpt-6-luna",
  "ingestion.captioner.base_url": "https://api.openai.com/v1",
  "ingestion.captioner.api_key_env": "OPENAI_API_KEY",
  "ingestion.transcriber.provider": "openai-spec",
  "ingestion.transcriber.model": "whisper-1",
  "ingestion.transcriber.base_url": "https://api.openai.com/v1",
  "ingestion.transcriber.api_key_env": "OPENAI_API_KEY",
  "ingestion.extractor.provider": "sandboxed",
  "ingestion.extractor.html_text": true,
  "sync.watcher.enabled": true,
  "sync.watcher.max_watch_paths": 5000,
  "sync.watcher.debounce_ms": 500,
  "sync.watcher.batch_window_ms": 2000,
  "sync.git.enabled": true,
  "sync.git.detect_commit_changes": true,
  "sync.git.detect_branch_switch": true,
  "sync.git.reindex_on_commit": true,
  "sync.scheduler.enabled": true,
  "sync.scheduler.interval_seconds": 300,
  "sync.limits.max_files": 250000,
  "sync.limits.max_file_size_mb": 1024,
  "sync.limits.max_total_mb": 16384,
  "sync.limits.follow_symlinks": false,
  "sync.concurrency.max_parallel_sources": 4,
  "sync.concurrency.max_parallel_files": 32,
  "sync.concurrency.max_parallel_embeddings": 8,
  "sync.concurrency.file_executor": "thread",
  "sync.concurrency.remote_worker_enabled": false,
  "sync.concurrency.remote_worker_batch_size": 16,
  "sync.concurrency.worker_transport": "http",
  "sync.concurrency.lock_timeout_seconds": 300,
  "sync.queue.enabled": false,
  "sync.queue.backend": "local",
  "graph.memory_entity_bridging": true,
  "graph.wasm_cross_source_resolution": true,
  "graph.max_nodes": 1500000,
  "security.allow_workspace_roots": ["/workspace", "/memory", "/state", "/exports"],
  "security.allow_user_selected_source_paths": true,
  "security.read_only_sources": true,
  "security.deny_path_traversal": true,
  "security.default_exclude_secrets": true,
  "memory.consolidation_enabled": true,
  "memory.session_ttl_days": null,
  "memory.user_ttl_days": null,
  "memory.org_ttl_days": null,
  "memory.default_policy": "prefer",
  "memory.steering_enabled": true,
  "memory.usage_tracking": true,
  "memory.max_records": 100000,
  "memory.about_max_targets": 8,
  "assistant.enabled": true,
  "assistant.provider": "openai",
  "assistant.model": "gpt-6-luna",
  "assistant.base_url": "https://api.openai.com/v1",
  "assistant.api_key_env": "OPENAI_API_KEY",
  "assistant.allow_session_keys": false,
  "assistant.max_context_chunks": 16,
  "assistant.max_output_tokens": 8192,
  "assistant.request_timeout_seconds": 120.0,
  "assistant.max_facts": 24,
  "assistant.workflow": "agentic",
  "assistant.retrieval.max_rounds": 2,
  "assistant.retrieval.per_query_results": 10,
  "assistant.retrieval.max_context_passages": 16,
  "assistant.retrieval.retrieval_modes": ["hybrid", "graph"],
  "assistant.retrieval.expand_graph": true,
  "assistant.retrieval.expand_depth": 2,
  "assistant.retrieval.expand_per_node": 6,
  "assistant.retrieval.grade_evidence": true,
  "assistant.retrieval.verify_citations": true,
  "assistant.retrieval.max_facts": 24,
  "sources": [
    {
      "name": "agent-memory",
      "type": "memory",
      "path": "/memory",
      "description": "Durable agent memory",
      "include": ["**/*.md"],
      "exclude": ["**/*.archived"],
      "sync": {
        "on_startup": true,
        "on_file_change": "debounce",
        "on_git_commit": false,
        "interval_seconds": 60
      }
    }
  ]
}
