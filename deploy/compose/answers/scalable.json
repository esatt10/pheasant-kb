{
  "pheasant.name": "pheasant-scalable",
  "pheasant.description": "High-throughput Pheasant fleet with PostgreSQL, NATS JetStream, gRPC workers, LanceDB, OpenAI, WASM, MCP, and opt-in durable memory",
  "pheasant.environment": "compose",
  "pheasant.log_level": "INFO",
  "pheasant.state_path": "/state",
  "pheasant.workspace_root": "/workspace",
  "pheasant.exports_path": "/exports",
  "server.host": "0.0.0.0",
  "server.port": 8765,
  "server.role": "all",
  "server.mcp.enabled": true,
  "server.mcp.transports": {
    "stdio": false,
    "streamable_http": true,
    "sse": false
  },
  "server.api.enabled": true,
  "server.api.openapi": true,
  "server.api.max_concurrent_requests": 32,
  "server.api.drain_seconds": 20,
  "server.api.graph_refresh_seconds": 30,
  "server.ui.enabled": true,
  "server.ui.graph_visualization": true,
  "storage.backend": "postgres",
  "storage.dsn_env": "PHEASANT_DATABASE_URL",
  "storage.pool_size": 16,
  "storage.graph_snapshots": true,
  "storage.graph_snapshot_interval_seconds": 900,
  "storage.graph_checkpoint_seconds": 120,
  "storage.checkpoint_mtbf_seconds": 86400,
  "storage.graph_checkpoint_max_seconds": 300,
  "storage.compression": "zstd",
  "storage.max_state_size_gb": 250,
  "search.default_mode": "hybrid",
  "search.max_results_default": 100,
  "search.embeddings.enabled": true,
  "search.embeddings.provider": "openai-spec",
  "search.embeddings.model": "text-embedding-3-small",
  "search.embeddings.base_url": "https://api.openai.com/v1",
  "search.embeddings.api_key_env": "OPENAI_API_KEY",
  "search.embeddings.dimensions": 1536,
  "search.embeddings.batch_size": 128,
  "search.embeddings.max_retries": 10,
  "search.embeddings.retry_backoff_seconds": 2.0,
  "search.embeddings.rate_limit_max_wait_seconds": 900.0,
  "search.vector_store.provider": "lancedb",
  "search.vector_store.path": "/state/vectors",
  "search.wasm_relationship_search": true,
  "ingestion.captioner.provider": "openai-spec",
  "ingestion.captioner.model": "gpt-5.6-luna",
  "ingestion.captioner.base_url": "https://api.openai.com/v1",
  "ingestion.captioner.api_key_env": "OPENAI_API_KEY",
  "ingestion.transcriber.provider": "openai-spec",
  "ingestion.transcriber.model": "whisper-1",
  "ingestion.transcriber.base_url": "https://api.openai.com/v1",
  "ingestion.transcriber.api_key_env": "OPENAI_API_KEY",
  "ingestion.extractor.provider": "auto",
  "ingestion.extractor.html_text": true,
  "ingestion.landing_service_url": "http://indexer:8765",
  "ingestion.landing_service_token_env": "PHEASANT_INGESTION_SERVICE_TOKEN",
  "sync.watcher.enabled": true,
  "sync.watcher.max_watch_paths": 20000,
  "sync.watcher.debounce_ms": 250,
  "sync.watcher.batch_window_ms": 1000,
  "sync.git.enabled": true,
  "sync.git.detect_commit_changes": true,
  "sync.git.detect_branch_switch": true,
  "sync.git.reindex_on_commit": true,
  "sync.scheduler.enabled": true,
  "sync.scheduler.interval_seconds": 900,
  "sync.limits.max_files": null,
  "sync.limits.max_file_size_mb": 100,
  "sync.limits.max_total_mb": null,
  "sync.limits.follow_symlinks": false,
  "sync.concurrency.max_parallel_sources": 4,
  "sync.concurrency.max_parallel_files": 16,
  "sync.concurrency.max_parallel_embeddings": 8,
  "sync.concurrency.file_executor": "remote",
  "sync.concurrency.remote_worker_urls": ["grpc://worker:8766"],
  "sync.concurrency.remote_worker_enabled": false,
  "sync.concurrency.remote_worker_token_env": "PHEASANT_INDEX_WORKER_TOKEN",
  "sync.concurrency.remote_worker_timeout_seconds": 120,
  "sync.concurrency.remote_worker_batch_size": 16,
  "sync.concurrency.worker_transport": "grpc",
  "sync.concurrency.lock_timeout_seconds": 300,
  "sync.queue.enabled": true,
  "sync.queue.backend": "nats",
  "sync.queue.visibility_seconds": 300,
  "sync.queue.max_attempts": 5,
  "sync.queue.nats_servers": ["nats://nats:4222"],
  "sync.queue.nats_stream": "PHEASANT_INDEX",
  "sync.queue.nats_subject": "pheasant.index.tasks",
  "sync.queue.nats_durable": "pheasant-indexers",
  "graph.memory_entity_bridging": true,
  "graph.wasm_cross_source_resolution": true,
  "graph.query_service_url": "http://graph:8765",
  "graph.query_service_token_env": "PHEASANT_GRAPH_SERVICE_TOKEN",
  "graph.query_service_timeout_seconds": 30.0,
  "graph.max_nodes": null,
  "security.allow_workspace_roots": ["/workspace", "/memory", "/state", "/exports"],
  "security.allow_user_selected_source_paths": false,
  "security.read_only_sources": true,
  "security.deny_path_traversal": true,
  "security.default_exclude_secrets": true,
  "security.acl_enforced": true,
  "security.default_visibility": "public",
  "security.api_auth.token_env": "PHEASANT_API_TOKEN",
  "memory.consolidation_enabled": true,
  "memory.session_ttl_days": null,
  "memory.user_ttl_days": null,
  "memory.org_ttl_days": null,
  "memory.default_policy": "prefer",
  "memory.steering_enabled": true,
  "memory.usage_tracking": true,
  "memory.max_records": null,
  "memory.about_max_targets": 12,
  "assistant.enabled": true,
  "assistant.provider": "openai",
  "assistant.model": "gpt-5.6-luna",
  "assistant.base_url": "https://api.openai.com/v1",
  "assistant.api_key_env": "OPENAI_API_KEY",
  "assistant.allow_session_keys": false,
  "assistant.max_context_chunks": 24,
  "assistant.max_output_tokens": 16384,
  "assistant.request_timeout_seconds": 180.0,
  "assistant.max_facts": 32,
  "assistant.workflow": "agentic",
  "assistant.retrieval.max_rounds": 2,
  "assistant.retrieval.per_query_results": 16,
  "assistant.retrieval.max_context_passages": 24,
  "assistant.retrieval.retrieval_modes": ["vector", "graph", "hybrid"],
  "assistant.retrieval.expand_graph": true,
  "assistant.retrieval.expand_depth": 2,
  "assistant.retrieval.expand_per_node": 8,
  "assistant.retrieval.grade_evidence": true,
  "assistant.retrieval.verify_citations": true,
  "assistant.retrieval.max_facts": 32,
  "readiness.enabled": true,
  "readiness.corpus_denylist": ["benchmark/*", "*.answers.json"],
  "readiness.max_search_latency_ms": 5000.0,
  "readiness.max_ingest_ack_ms": 30000.0,
  "readiness.max_index_lag_ms": 120000.0,
  "readiness.latency_probe_queries": 12,
  "readiness.concurrency_probe_writers": 4,
  "readiness.concurrency_probe_items": 5,
  "sources": []
}
