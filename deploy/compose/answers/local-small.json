{
  "pheasant.name": "pheasant-local-small",
  "pheasant.description": "Offline-first local Pheasant profile for a laptop or small corpus",
  "pheasant.environment": "local",
  "pheasant.log_level": "INFO",
  "pheasant.state_path": ".pheasant/state",
  "pheasant.workspace_root": ".",
  "pheasant.exports_path": ".pheasant/exports",
  "server.host": "0.0.0.0",
  "server.port": 8765,
  "server.role": "all",
  "server.mcp.enabled": true,
  "server.mcp.transports": {
    "stdio": true,
    "streamable_http": true,
    "sse": false
  },
  "server.api.enabled": true,
  "server.api.openapi": true,
  "server.api.max_concurrent_requests": 16,
  "server.api.drain_seconds": 0,
  "server.api.graph_refresh_seconds": 0,
  "server.ui.enabled": true,
  "server.ui.graph_visualization": true,
  "storage.backend": "sqlite",
  "storage.graph_snapshots": true,
  "storage.graph_snapshot_interval_seconds": 900,
  "storage.graph_checkpoint_seconds": 120,
  "storage.checkpoint_mtbf_seconds": 86400,
  "storage.graph_checkpoint_max_seconds": 900,
  "storage.compression": "zstd",
  "storage.max_state_size_gb": 5,
  "search.default_mode": "text",
  "search.max_results_default": 10,
  "search.embeddings.enabled": false,
  "search.embeddings.provider": "stub",
  "search.vector_store.provider": "numpy",
  "search.wasm_relationship_search": false,
  "ingestion.captioner.provider": "stub",
  "ingestion.transcriber.provider": "stub",
  "ingestion.extractor.provider": "auto",
  "ingestion.extractor.html_text": true,
  "sync.watcher.enabled": true,
  "sync.watcher.max_watch_paths": 100,
  "sync.watcher.debounce_ms": 1500,
  "sync.watcher.batch_window_ms": 5000,
  "sync.git.enabled": true,
  "sync.git.detect_commit_changes": true,
  "sync.git.detect_branch_switch": true,
  "sync.git.reindex_on_commit": true,
  "sync.scheduler.enabled": true,
  "sync.scheduler.interval_seconds": 900,
  "sync.limits.max_files": 50000,
  "sync.limits.max_file_size_mb": 1024,
  "sync.limits.max_total_mb": 4096,
  "sync.limits.follow_symlinks": false,
  "sync.concurrency.max_parallel_sources": 1,
  "sync.concurrency.max_parallel_files": 8,
  "sync.concurrency.max_parallel_embeddings": 1,
  "sync.concurrency.file_executor": "thread",
  "sync.concurrency.remote_worker_enabled": false,
  "sync.concurrency.remote_worker_batch_size": 8,
  "sync.concurrency.worker_transport": "http",
  "sync.concurrency.lock_timeout_seconds": 120,
  "sync.queue.enabled": false,
  "sync.queue.backend": "local",
  "graph.memory_entity_bridging": true,
  "graph.wasm_cross_source_resolution": false,
  "graph.max_nodes": 250000,
  "security.allow_workspace_roots": ["."],
  "security.allow_user_selected_source_paths": true,
  "security.read_only_sources": true,
  "security.deny_path_traversal": true,
  "security.default_exclude_secrets": true,
  "memory.consolidation_enabled": true,
  "memory.session_ttl_days": null,
  "memory.user_ttl_days": null,
  "memory.org_ttl_days": null,
  "memory.default_policy": "prefer",
  "memory.steering_enabled": false,
  "memory.usage_tracking": true,
  "memory.max_records": 10000,
  "memory.about_max_targets": 3,
  "assistant.enabled": true,
  "assistant.provider": "none",
  "assistant.allow_session_keys": false,
  "assistant.max_context_chunks": 6,
  "assistant.max_output_tokens": 2048,
  "assistant.request_timeout_seconds": 30.0,
  "assistant.max_facts": 8,
  "assistant.workflow": "simple",
  "assistant.retrieval.max_rounds": 1,
  "assistant.retrieval.per_query_results": 4,
  "assistant.retrieval.max_context_passages": 6,
  "assistant.retrieval.retrieval_modes": ["text"],
  "assistant.retrieval.expand_graph": true,
  "assistant.retrieval.expand_depth": 1,
  "assistant.retrieval.expand_per_node": 2,
  "assistant.retrieval.grade_evidence": false,
  "assistant.retrieval.verify_citations": true,
  "assistant.retrieval.max_facts": 8,
  "sources": [
    {
      "name": "agent-memory",
      "type": "memory",
      "path": ".pheasant/memory",
      "description": "Durable local agent memory",
      "include": ["**/*.md"],
      "exclude": ["**/*.archived"],
      "sync": {
        "on_startup": true,
        "on_file_change": "debounce",
        "on_git_commit": false,
        "interval_seconds": 60
      }
    }
  ]
}
