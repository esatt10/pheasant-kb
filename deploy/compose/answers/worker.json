{
  "pheasant.name": "pheasant-scalable-worker",
  "pheasant.defaults": "standalone",
  "pheasant.description": "Stateless gRPC preparation worker for the scalable Pheasant fleet",
  "pheasant.environment": "compose",
  "pheasant.log_level": "INFO",
  "pheasant.state_path": "/state",
  "pheasant.workspace_root": "/workspace",
  "pheasant.exports_path": "/exports",
  "server.host": "0.0.0.0",
  "server.port": 8765,
  "server.role": "worker",
  "server.mcp.enabled": false,
  "server.api.enabled": false,
  "server.api.openapi": false,
  "server.ui.enabled": false,
  "sync.watcher.enabled": false,
  "sync.git.enabled": false,
  "sync.scheduler.enabled": false,
  "sync.concurrency.max_parallel_sources": 1,
  "sync.concurrency.max_parallel_files": 32,
  "sync.concurrency.max_parallel_embeddings": 1,
  "sync.concurrency.file_executor": "thread",
  "sync.concurrency.remote_worker_enabled": true,
  "sync.concurrency.remote_worker_token_env": "PHEASANT_INDEX_WORKER_TOKEN",
  "sync.concurrency.remote_worker_timeout_seconds": 300,
  "sync.concurrency.remote_worker_batch_size": 16,
  "sync.concurrency.worker_transport": "grpc",
  "sync.queue.enabled": false,
  "search.embeddings.enabled": false,
  "graph.memory_entity_bridging": false,
  "graph.wasm_cross_source_resolution": true,
  "assistant.enabled": false,
  "sources": []
}
