# Pheasant Compose environment — copy this file to the repository root as `.env`.
#
#   cp deploy/compose/.env.example .env
#
# Docker Compose auto-loads `.env` from the directory you run `docker compose`
# in, so every value below reaches the container as a real environment
# variable without ever being written into a config file, a Docker image, or
# `/state`. `.env` is already gitignored — keep secrets out of git by editing
# the copy, never this template.
#
# None of this is required to run pheasant at all: with an empty `.env` (or
# none) you get keyword-only search, extractive answers, and no third-party
# connectors — a fully working, zero-secret deployment. Everything below is
# opt-in, and each block says which YAML config key turns the corresponding
# feature on.
#
# =============================================================================
# CORE DEPLOYMENT — manifests under deploy/compose/
# =============================================================================
# All optional; every one of these has a working default already baked into
# the compose file. Set only what you want to change.

# Which published image to run. Pin an explicit tag for reproducibility, or
# leave unset for the version this checkout matches.
# PHEASANT_IMAGE=ghcr.io/esatt10/pheasant:0.12.9
# PHEASANT_UI_IMAGE=ghcr.io/esatt10/pheasant-ui:0.12.9
# PHEASANT_CONTAINER_NAME=pheasant

# Host bind address for the published ports. Loopback-only by default: the
# HTTP API is unauthenticated, and Docker's own iptables rules bypass most
# host firewalls, so a bare 0.0.0.0 hands your whole index to anyone on the
# network. Only widen this behind an authenticating reverse proxy.
# PHEASANT_BIND=127.0.0.1

# Host port for the bundled UI, API and MCP server.
# PHEASANT_PORT=8765

# Optional host workspace. Leave unset for the managed named volume. Windows
# paths work with forward slashes (C:/Users/you/notes).
# PHEASANT_WORKSPACE_PATH=./workspace

# Required by docker-compose.scale.yml — the fleet refuses to start without
# them. Four separate values, because they are four separate trust
# boundaries and sharing one collapses the others onto the weakest:
#
#   openssl rand -hex 32   # once per variable, not once
#
#   PHEASANT_API_TOKEN            callers -> the region's API. Every request
#                                 outside /health, /ready and /metrics needs
#                                 `Authorization: Bearer <this>`. Drop it and
#                                 set security.api_auth.behind_authenticating_proxy
#                                 instead if an ingress already authenticates.
#   PHEASANT_GRAPH_SERVICE_TOKEN  API/MCP replicas -> the internal graph API,
#                                 which serves the whole graph. Must differ
#                                 from the worker token; `serve` refuses to
#                                 start if they match.
#   PHEASANT_INDEX_WORKER_TOKEN   the indexer -> the gRPC/HTTP preparation
#                                 workers. Every coordinator and worker shares
#                                 this one value; it is also the only secret a
#                                 worker holds at all.
#   PHEASANT_INGESTION_SERVICE_TOKEN
#                                 API replicas -> the indexer's landing
#                                 service. Manual uploads are forwarded to the
#                                 tier that can write /state rather than the
#                                 serving tier being given write access.
#                                 Holding it means being able to put bytes
#                                 into the corpus, so it must differ from the
#                                 worker token too; `serve` refuses if they
#                                 match.
#
# Set a real Postgres password when the database is reachable beyond the
# Compose network.
# PHEASANT_API_TOKEN=replace-with-at-least-32-random-bytes
# PHEASANT_GRAPH_SERVICE_TOKEN=replace-with-a-different-32-random-bytes
# PHEASANT_INDEX_WORKER_TOKEN=replace-with-a-third-32-random-bytes
# PHEASANT_INGESTION_SERVICE_TOKEN=replace-with-a-fourth-32-random-bytes
# POSTGRES_PASSWORD=replace-with-a-random-password

# Extras baked into the image at build time (`docker build --build-arg
# PHEASANT_EXTRAS=...`), comma-separated. Only pay for what your config
# actually uses — each is gated so a region that never enables the matching
# feature needs none of this:
#   mcp     MCP server transport (baked into every published image already)
#   vector  lancedb — REQUIRED if search.vector_store.provider: lancedb
#           (the default embed-on-sync store, `numpy`, needs no extra)
#   agent   langgraph + langchain-core — REQUIRED for assistant.workflow:
#           agentic (or auto, once a chat provider key below is set — auto
#           silently falls back to the single-pass workflow without this)
#   a2a     cryptography — only if synapse.signing_key_ref is set
#   wasm    wasmtime — only if any connector.runtime: sandboxed source, or
#           graph.wasm_cross_source_resolution / search.wasm_relationship_search
# PHEASANT_EXTRAS=mcp

# =============================================================================
# GITHUB — cloning/fetching PRIVATE repositories
# =============================================================================
# `pheasant up https://github.com/owner/private-repo` (and the equivalent
# `pheasant host` / UI quick-add flows) clone over plain HTTPS with no
# credential of any kind by default — that's fine for a public repo, but a
# private one just fails ("could not clone ... Authentication failed").
# Setting either of these makes GitHub HTTPS clones/fetches authenticate
# automatically; nothing else changes, and a repo you already have local
# access to needs neither. GITHUB_TOKEN is checked first (also the ambient
# name GitHub Actions sets); GH_TOKEN (the `gh` CLI's name) is the fallback
# if only that is set. A fine-grained PAT scoped to "Contents: Read-only" on
# just the repos you want indexed is the least-privilege choice; a classic
# PAT needs the `repo` scope for a private repository.
# GITHUB_TOKEN=ghp_replace-me
# GH_TOKEN=

# =============================================================================
# AI PROVIDERS — embeddings, image/audio captioning, and chat
# =============================================================================
# One key per provider; every consumer below reads it by env var *name* only
# (never stored in config, state, or logs). `search.embeddings.api_key_env`,
# `ingestion.captioner.api_key_env`, `ingestion.transcriber.api_key_env`, and
# `assistant.api_key_env` all default to OPENAI_API_KEY, so one key usually
# covers indexing (embeddings/captions/transcripts) AND chat — set the others
# only if you point a specific feature at a different provider.

# search.embeddings.provider: openai-spec (default api_key_env)
# ingestion.captioner.provider: openai-spec
# ingestion.transcriber.provider: openai-spec
# assistant.provider: openai (or "auto", if this is the only key set)
OPENAI_API_KEY=sk-replace-me

# assistant.provider: anthropic
ANTHROPIC_API_KEY=sk-ant-replace-me

# assistant.provider: gemini
GEMINI_API_KEY=replace-me

# =============================================================================
# CONNECTORS — third-party source credentials
# =============================================================================
# Each is read from the env var named by that source's `connector.api_key_env`
# in pheasant.yaml; these are the built-in defaults (override per-source if
# you need two accounts of the same connector type at once). Unset = that
# connector type simply isn't usable, same as not enabling `search.embeddings`.

# sources[].type: notion
NOTION_TOKEN=secret_replace-me

# sources[].type: gdrive
GDRIVE_TOKEN=replace-me

# sources[].type: slack (bot token)
SLACK_TOKEN=xoxb-replace-me

# sources[].type: confluence
CONFLUENCE_TOKEN=replace-me

# sources[].type: imap — format is "user:password", not a bare token
IMAP_CREDENTIALS=you@example.com:app-password-replace-me

# =============================================================================
# SECURITY — external identity provider group sync (Phase 32.4)
# =============================================================================
# security.idp.enabled: true / security.idp.api_key_env (default below).
# Only needed if you turn on IdP-synced ACL groups; security.acl_enforced and
# the config-mapped security.groups work with no env vars at all.
# IDP_TOKEN=replace-me

# =============================================================================
# SYNAPSE — Ed25519 contract signing (Phase 24.4, [x-repo], advanced)
# =============================================================================
# synapse.signing_key_ref points at a secret *reference* — "env://NAME" or a
# bare env var name — not a literal key. Only relevant if this region joins a
# Synapse fleet that verifies signed contracts; unset (default) means
# integrity.signature stays null and a standalone/router-less pheasant is
# completely unaffected. Value is a base64-encoded 32-byte Ed25519 seed.
# PHEASANT_SIGNING_KEY=replace-me-base64-ed25519-seed
