# pheasant environment — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Docker Compose auto-loads `.env` from the directory you run `docker compose`
# in, so every value here reaches the container as a real environment variable
# without ever being written into a config file, an image, or `/state`. `.env`
# is gitignored; this template is not, so it must never hold a real secret.
#
# `deploy/compose/.env.example` is the fuller, annotated reference covering
# every optional connector and provider. This file is the short version: the
# variables this checkout actually uses, in the order you need them.
#
# Nothing here is required to run pheasant at all. With an empty `.env` you get
# keyword-only search, extractive answers and no third-party connectors — a
# working, zero-secret deployment. Everything below is opt-in, except where a
# block says the fleet refuses to start without it.

# =============================================================================
# CORE DEPLOYMENT — docker-compose.yml (the single container)
# =============================================================================
# Which image to run. `pheasant:local` means you built it yourself, which is
# needed for the vector/agent/wasm extras — only `mcp` is baked into the
# published image. Leave unset to use the published tag.
PHEASANT_IMAGE=pheasant:local

# Host paths bind-mounted into the container.
PHEASANT_CONFIG_PATH=./pheasant.yaml
PHEASANT_WORKSPACE_PATH=.
PHEASANT_DATA_PATH=./data
PHEASANT_VAULT_PATH=./vault
# Extra mount added by docker-compose.override.yml for the agent-memory source
# (path: /memory in pheasant.yaml — /workspace is read-only, this one is not).
PHEASANT_MEMORY_PATH=./memory

# Extras baked in at image build time (`docker build --build-arg`):
#   mcp    -> server.mcp.enabled
#   vector -> search.vector_store.provider: lancedb
#   agent  -> assistant.workflow: auto
#   wasm   -> graph.wasm_cross_source_resolution
PHEASANT_EXTRAS=mcp,vector,agent,wasm

# Host bind address for published ports. Loopback by default: a token is
# authentication, not a perimeter, and Docker's iptables rules bypass most
# host firewalls. Widen only behind an ingress that authenticates.
# PHEASANT_BIND=127.0.0.1
# PHEASANT_PORT=8765

# =============================================================================
# GITHUB — cloning private repositories as sources
# =============================================================================
# A fine-grained PAT scoped to "Contents: Read-only" on the repositories you
# index (or a classic PAT with the `repo` scope).
GITHUB_TOKEN=github_pat_replace_me

# =============================================================================
# AI PROVIDERS — embeddings, image captioning, chat
# =============================================================================
# Covers search.embeddings (semantic search), ingestion.captioner (image
# captions) and the assistant. Without it, search is keyword-only and answers
# are extractive — still a working deployment, just a smaller one.
OPENAI_API_KEY=sk-replace-me

# =============================================================================
# FLEET — deploy/compose/docker-compose.scale.yml only
# =============================================================================
# Not needed for the single container. The fleet refuses to start without every
# one of these: each is declared `${VAR:?}` in the compose file, so a missing
# value fails the whole stack rather than degrading one tier.
#
# FOUR SEPARATE VALUES. One `openssl rand -hex 32` per line, not one reused:
#
#   openssl rand -hex 32
#
# These are four trust boundaries, and the weakest holder of a shared value
# sets the strength of every boundary it spans. The shipped compose file once
# wired the graph token to the worker token's value, which read as thrift and
# was a trust-boundary collapse — workers are the least-trusted tier and hold
# the indexing token by necessity, so one value meant any compromised worker
# also held the credential for the internal graph API.

# Callers -> the region's API. Every request outside /health, /ready and
# /metrics carries `Authorization: Bearer <this>`. Omit it only if an ingress
# already authenticates, and say so with
# security.api_auth.behind_authenticating_proxy: true.
PHEASANT_API_TOKEN=replace-with-32-random-bytes

# The indexer -> the gRPC/HTTP preparation workers. Shared by every coordinator
# and worker, and the only secret a worker holds at all.
PHEASANT_INDEX_WORKER_TOKEN=replace-with-a-second-32-random-bytes

# API/MCP replicas -> the internal graph API, which serves the whole graph.
# Must differ from the worker token; `serve` refuses to start if they match.
PHEASANT_GRAPH_SERVICE_TOKEN=replace-with-a-third-32-random-bytes

# API replicas -> the indexer's internal landing service.
#
# This is what makes manual upload work in the fleet. An api replica mounts
# /state read-only, because the indexer is the sole writer of committed state —
# so the UI drop zone and an agent's `ingest_submit` have nowhere to put their
# bytes. They are forwarded to the indexer, which performs the identical local
# write, and the serving tier still writes nothing.
#
# A *write* credential: holding it means being able to put bytes into the
# corpus. It must differ from the worker token too — a worker parses bytes the
# indexer hands it and has no business choosing what the region indexes — and
# `serve` refuses to start if they match.
PHEASANT_INGESTION_SERVICE_TOKEN=replace-with-a-fourth-32-random-bytes

# Postgres. Set a real password whenever the database is reachable beyond the
# Compose network.
POSTGRES_PASSWORD=replace-with-a-random-password
